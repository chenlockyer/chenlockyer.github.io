<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="Hexo">
  <title><%= page.title ? page.title + ' · ' + config.author : config.title %></title>
  <meta name="description" content="<%= page.description || theme.profile.name %>，<%= theme.profile.role %>。做人形机器人二次开发：全身运动控制、导航导览、多机群控。">
  <meta name="author" content="<%= config.author %>">
  <meta name="theme-color" content="#f7f6f3">

  <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'profile' %>">
  <meta property="og:title" content="<%= page.title ? page.title + ' · ' + config.author : config.title %>">
  <meta property="og:description" content="<%= page.description || theme.profile.position %>">
  <meta property="og:url" content="<%= config.url + page.path %>">
  <meta property="og:image" content="<%= config.url %>/images/avatar.jpg">
  <meta property="og:site_name" content="<%= config.author %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="<%= config.url + page.path %>">

  <link rel="icon" href="<%= url_for('/images/favicon.svg') %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="<%= url_for('/images/avatar.jpg') %>">

  <link rel="preload" href="<%= url_for('/fonts/stix-400.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%= url_for('/fonts/notoserif-sc-400.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%= url_for('/fonts/notoserif-sc-600.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "陈洛嘉",
    "alternateName": "Chen Lockyer",
    "url": "<%= config.url %>",
    "image": "<%= config.url %>/images/avatar.jpg",
    "jobTitle": "计算机科学与技术本科生",
    "affiliation": { "@type": "CollegeOrUniversity", "name": "深圳技术大学" },
    "knowsAbout": ["人形机器人", "全身运动控制", "强化学习", "ROS2", "SLAM", "多机群控"],
    "sameAs": ["<%= theme.contact.github %>", "https://chenlockyer.github.io/studio/"]
  }
  </script>
  <% if (typeof inject_head !== 'undefined') { %><%- inject_head %><% } %>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>

  <header class="bar">
    <a class="wordmark" href="<%= url_for('/') %>">
      <span class="wm-cn"><%= theme.profile.name %></span>
      <span class="wm-en"><%= theme.profile.name_en %></span>
    </a>
    <nav class="nav" aria-label="主导航">
      <% Object.keys(theme.menu).forEach(function(label){ %>
        <% var href = theme.menu[label]; %>
        <% var on = href === '/' ? (page.path === '' || page.path === 'index.html') : page.path.indexOf(href) === 0; %>
        <a href="<%= url_for(href) %>"<% if (on) { %> aria-current="page"<% } %>><%= label %></a>
      <% }); %>
    </nav>
    <a class="nav-studio" href="<%= theme.studio.url %>" target="_blank" rel="noopener">
      <%= theme.studio.label %>
      <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false"><path d="M3 9L9 3M9 3H4M9 3v5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </header>

  <main id="main">
    <%- body %>
  </main>

  <footer class="foot">
    <p class="foot-what"><%= theme.profile.name %> · 人形机器人二次开发</p>
    <nav class="foot-links" aria-label="页脚导航">
      <a href="<%= url_for('/about/') %>">履历</a>
      <a href="<%= url_for('/projects/') %>">项目</a>
      <a href="<%= theme.contact.github %>" target="_blank" rel="noopener">GitHub</a>
      <a href="<%= theme.studio.url %>" target="_blank" rel="noopener">工作室</a>
      <a href="mailto:<%= theme.contact.email %>">邮箱</a>
    </nav>
    <p class="foot-meta">© <%= new Date().getFullYear() %> · <%= theme.contact.city %></p>
  </footer>

  <script src="<%= url_for('/js/main.js') %>" defer></script>
  <% if (typeof inject_bottom !== 'undefined') { %><%- inject_bottom %><% } %>
</body>
</html>
