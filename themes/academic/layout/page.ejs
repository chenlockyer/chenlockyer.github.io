<!-- 通用页面 -->
<article class="page<%- page.page_class ? ' ' + page.page_class : '' %>">
  <% if (page.title) { %>
  <h1 class="page-title"><%= page.title %></h1>
  <% } %>
  <% if (page.lead) { %><p class="page-lead"><%- page.lead %></p><% } %>

  <div class="post-content">
    <%- page.content %>
  </div>

  <p class="page-back"><a class="txtlink" href="<%= url_for('/') %>">← 返回首页</a></p>
</article>
